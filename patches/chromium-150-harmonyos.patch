+void RefreshOhosNativeThemeFontCache() {
+  void* library = dlopen("libnative_drawing.so", RTLD_NOW | RTLD_LOCAL);
+  if (!library) {
+    return;
+  }
+
+  using GetGlobalCollectionFunction = OH_Drawing_FontCollection* (*)();
+  using ClearFontCachesFunction = void (*)(OH_Drawing_FontCollection*);
+  auto get_global_collection = reinterpret_cast<GetGlobalCollectionFunction>(
+      dlsym(library, "OH_Drawing_GetFontCollectionGlobalInstance"));
+  auto clear_font_caches = reinterpret_cast<ClearFontCachesFunction>(
+      dlsym(library, "OH_Drawing_ClearFontCaches"));
+  if (get_global_collection && clear_font_caches) {
+    if (OH_Drawing_FontCollection* collection = get_global_collection()) {
+      clear_font_caches(collection);
+    }
+  }
+  dlclose(library);
+}
