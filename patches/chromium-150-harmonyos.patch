+OhosFontConfiguration ReadOhosFontConfiguration() {
+  OhosFontConfiguration result;
+  void* library = dlopen("libnative_drawing.so", RTLD_NOW | RTLD_LOCAL);
+  if (!library) {
+    return result;
+  }
+
+  using GetConfigFunction =
+      OH_Drawing_FontConfigInfo* (*)(OH_Drawing_FontConfigInfoErrorCode*);
+  using DestroyConfigFunction = void (*)(OH_Drawing_FontConfigInfo*);
+  auto get_config = reinterpret_cast<GetConfigFunction>(
+      dlsym(library, "OH_Drawing_GetSystemFontConfigInfo"));
+  auto destroy_config = reinterpret_cast<DestroyConfigFunction>(
+      dlsym(library, "OH_Drawing_DestroySystemFontConfigInfo"));
+  if (!get_config || !destroy_config) {
+    dlclose(library);
+    return result;
+  }
+
+  OH_Drawing_FontConfigInfoErrorCode error = ERROR_FONT_CONFIG_INFO_UNKNOWN;
+  OH_Drawing_FontConfigInfo* config = get_config(&error);
+  if (config && error == SUCCESS_FONT_CONFIG_INFO) {
+    for (size_t index = 0; index < config->fontDirSize; ++index) {
+      if (config->fontDirSet[index] && config->fontDirSet[index][0]) {
+        result.directories.emplace_back(config->fontDirSet[index]);
+      }
+    }
+  }
+  if (config) {
+    destroy_config(config);
+  }
+  dlclose(library);
+  return result;
+}
