+WindowOpenDisposition GetPlatformAdjustedWindowOpenDisposition(
+    WindowOpenDisposition disposition) {
+#if BUILDFLAG(IS_OHOS)
+  // The HarmonyOS Aura shell is embedded into one ArkUI XComponent. Creating
+  // another Browser window has no second native surface and leaves the hidden
+  // window owning focus, so preserve the request as a foreground tab instead.
